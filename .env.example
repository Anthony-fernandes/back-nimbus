DEBUG=False
SECRET_KEY=replace-with-a-strong-secret
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
POSTGRES_DB=nimbus
POSTGRES_USER=nimbus
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_HOST=
POSTGRES_PORT=5432
REDIS_URL=redis://localhost:6379/0
ALLOWED_HOSTS=yourdomain.com
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://front-nimbus.vercel.app
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:3000,https://front-nimbus.vercel.app
SECURE_SSL_REDIRECT=True

# Email
EMAIL_HOST=smtp.yourdomain.com
EMAIL_HOST_USER=noreply@yourdomain.com
EMAIL_HOST_PASSWORD=change_me
DEFAULT_FROM_EMAIL=noreply@yourapp.com

# Security
SECURE_HSTS_SECONDS=31536000

# Platform
PLATFORM_WEB_URL=https://yourapp.com
PLATFORM_NAME=Stratos Suite

# Sentry
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
DJANGO_ENV=production

# Celery Beat (django_celery_beat)
# Run: python manage.py migrate django_celery_beat
